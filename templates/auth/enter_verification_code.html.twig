{% extends "auth/base.html.twig" %}

{% block title %}Verificar correu electrònic{% endblock %}

{% block content %}
<div class="auth-form verify-email-form">
  <h1>Verifica el teu compte</h1>
  <h5>Per completar el registre, verifica el teu correu electrònic introduint el codi que t'hem enviat</h5>

  {% if errors %}
    <div class="missatge-error">
      <ul>
        {% for error in errors %}
          <li>{{ error }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  <form action="/verify-email" method="POST">
    <div class="input-container">
      <input type="text" name="verification-code" required maxlength="6" pattern="\d{6}">
      <i class="fa-solid fa-envelope-circle-check"></i>
    </div>

    <button type="submit">Verifica</button>
  </form>
</div>
{% endblock %}