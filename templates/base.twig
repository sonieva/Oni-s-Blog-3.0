<!DOCTYPE html>
<html lang="ca">
<head>
  <!-- Metadades bàsiques i configuració de la vista. -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Oni's Blog 3.0 | {{ title }}</title>
  <link rel="icon" href="assets/img/logo.png" type="image/x-icon">
  <link rel="stylesheet" href="assets/css/fonts.css" type="text/css">
  <link rel="stylesheet" href="assets/fontawesome/css/fontawesome.min.css"/>
  <link rel="stylesheet" href="assets/fontawesome/css/solid.min.css"/>
  <link rel="stylesheet" href="assets/css/header.css" type="text/css">
  <link rel="stylesheet" href="assets/css/styles.css" type="text/css">
  <script defer src="assets/js/jquery.min.js"></script>
  <script defer type="module" src="assets/js/main.js"></script>
</head>
<body>
  <nav class="navbar">
    <div class="logo">
      <a class="logo" href="/">
        <img src="assets/img/logo.png" alt="Logo" width="40" height="40" class="logo-img">
        <h4 class="logo-name">Oni's Blog 3.0</h4>
      </a>
      <h2 class="vertical-bar">|</h2>
      <h4 class="nom-pantalla">{{ title }}</h4>
    </div>

    <div class="nav-items">
      <a class="nav-item" href="/">
        <i class="fa-solid fa-house"></i>Inici
      </a>

      <div class="nav-item">
        <button id="dropdown-toggle">
          {% if user %}
            <img src="{{ user.img_path ?: 'assets/img/placeholder-usuari.png' }}" alt="Imatge de perfil" class="foto-perfil-header" id="foto-perfil-header">
          {% else %}
            <img src="assets/icons/incognito.svg" alt="Usuari anònim" height="21" width="21">
          {% endif %}
          <span id="header-nom">{{ user ? (user.full_name ?: user.nicname) : "Identifica't" }}</span>
          <i id="caret" class="fa-solid fa-caret-left"></i>
        </button>

        <div id="dropdown" class="dropdown-content">
          {% if user %}
            <a href="perfil">
              <i class="fa-solid fa-user-gear"></i>Perfil
            </a>
            <a href="dashboard">
              <i class="fa-solid fa-gauge-high"></i>Dashboard
            </a>
            {% if user.role == 'admin' %}
              <a href="admin" class="admin-link">
                <i class="fa-solid fa-users-gear"></i>Gestió d'usuaris
              </a>
            {% endif %}
            <a href="logout">
              <i class="fa-solid fa-right-from-bracket"></i>Sortir
            </a>
          {% else %}
            <a href="login">
              <i class="fa-solid fa-right-to-bracket"></i>Iniciar sessió
            </a>
            <a href="signup">
              <i class="fa-solid fa-user-plus"></i>Crear compte
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </nav>

  <main>
    {% block content %}{% endblock %}
  </main>

  {% block scripts %}{% endblock %}
</body>

</html>
